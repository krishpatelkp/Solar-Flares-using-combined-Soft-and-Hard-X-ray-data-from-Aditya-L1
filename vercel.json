{
  "version": 2,
  "buildCommand": "cd solar_flare_frontend && npm install && npm run build",
  "outputDirectory": "solar_flare_frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
